#!/bin/bash
set -euo pipefail

export HOME="$SNAP_USER_COMMON"
export XDG_CONFIG_HOME="$SNAP_USER_COMMON/.config"
export XDG_DATA_HOME="$SNAP_USER_COMMON/.local/share"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
export XDG_STATE_HOME="$SNAP_USER_COMMON/.local/state"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"

# ScreenCast supplies its own video fd; native audio needs the session socket.
export PIPEWIRE_RUNTIME_DIR="${XDG_RUNTIME_DIR%/snap."$SNAP_INSTANCE_NAME"}"

exec "$SNAP/opt/openscreen/openscreen" --no-sandbox "$@"
